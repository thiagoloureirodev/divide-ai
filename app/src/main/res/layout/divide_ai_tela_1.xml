<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF8FF"
    tools:context=".DivideAi_tela_1">

    <ImageView
        android:id="@+id/imgPessoas"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="64dp"
        android:contentDescription="Logo Divide Aí"
        android:src="@drawable/ic_pessoas_divide_ai"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/txtTitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="Divide Aí"
        android:textColor="#512DA8"
        android:textSize="30sp"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@id/imgPessoas"
        app:layout_constraintTop_toTopOf="@id/imgPessoas" />

    <TextView
        android:id="@+id/txtSubtitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="2dp"
        android:text="Divida a conta de forma justa"
        android:textColor="#555555"
        android:textSize="15sp"
        app:layout_constraintStart_toEndOf="@id/imgPessoas"
        app:layout_constraintTop_toBottomOf="@id/txtTitulo" />

    <TextView
        android:id="@+id/txtValorConta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="48dp"
        android:text="Valor da conta"
        android:textColor="#512DA8"
        android:textSize="17sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/imgPessoas" />

    <EditText
        android:id="@+id/edtValorConta"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/edittext_borda"
        android:drawableStart="@drawable/ic_carteira_roxa"
        android:drawablePadding="14dp"
        android:gravity="center_vertical"
        android:hint="R$ 0,00"
        android:inputType="numberDecimal"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:textColor="#000000"
        android:textColorHint="#777777"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtValorConta" />

    <TextView
        android:id="@+id/txtNumeroPessoas"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="28dp"
        android:text="Número de pessoas"
        android:textColor="#512DA8"
        android:textSize="17sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/edtValorConta" />

    <EditText
        android:id="@+id/edtNumeroPessoas"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/edittext_borda"
        android:drawableStart="@drawable/ic_pessoa_roxa"
        android:drawablePadding="14dp"
        android:gravity="center_vertical"
        android:hint="Número de pessoas"
        android:inputType="number"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:textColor="#000000"
        android:textColorHint="#777777"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtNumeroPessoas" />

    <TextView
        android:id="@+id/txtGorjeta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="28dp"
        android:text="Gorjeta"
        android:textColor="#512DA8"
        android:textSize="17sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/edtNumeroPessoas" />

    <Button
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:id="@+id/btnGorjeta0"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="4dp"
        android:backgroundTint="#FFFFFF"
        android:text="0%"
        android:textColor="#000000"
        android:textSize="15sp"
        app:cornerRadius="10dp"
        app:layout_constraintEnd_toStartOf="@id/btnGorjeta10"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtGorjeta" />

    <Button
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:id="@+id/btnGorjeta10"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:backgroundTint="#512DA8"
        android:text="10%"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        app:cornerRadius="10dp"
        app:layout_constraintBottom_toBottomOf="@id/btnGorjeta0"
        app:layout_constraintEnd_toStartOf="@id/btnGorjeta15"
        app:layout_constraintStart_toEndOf="@id/btnGorjeta0"
        app:layout_constraintTop_toTopOf="@id/btnGorjeta0" />

    <Button
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:id="@+id/btnGorjeta15"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:backgroundTint="#FFFFFF"
        android:text="15%"
        android:textColor="#000000"
        android:textSize="15sp"
        app:cornerRadius="10dp"
        app:layout_constraintBottom_toBottomOf="@id/btnGorjeta0"
        app:layout_constraintEnd_toStartOf="@id/btnGorjeta20"
        app:layout_constraintStart_toEndOf="@id/btnGorjeta10"
        app:layout_constraintTop_toTopOf="@id/btnGorjeta0" />

    <Button
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:id="@+id/btnGorjeta20"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="24dp"
        android:backgroundTint="#FFFFFF"
        android:text="20%"
        android:textColor="#000000"
        android:textSize="15sp"
        app:cornerRadius="10dp"
        app:layout_constraintBottom_toBottomOf="@id/btnGorjeta0"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/btnGorjeta15"
        app:layout_constraintTop_toTopOf="@id/btnGorjeta0" />

    <Button
        android:id="@+id/btnCalcular"
        android:layout_width="0dp"
        android:layout_height="58dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="24dp"
        android:backgroundTint="#512DA8"
        android:text="CALCULAR"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:textStyle="bold"
        app:cornerRadius="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnGorjeta10" />

    <ImageView
        android:id="@+id/imgFinanceiro"
        android:layout_width="0dp"
        android:layout_height="180dp"
        android:layout_marginStart="32dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="32dp"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter"
        android:src="@drawable/imagemtela1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnCalcular"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>